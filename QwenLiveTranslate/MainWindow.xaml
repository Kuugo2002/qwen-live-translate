<Window x:Class="QwenLiveTranslate.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="俄语实时翻译助手" Width="1120" Height="800" MinWidth="850" MinHeight="650" Background="#F4F7FB" FontFamily="Microsoft YaHei UI" FontSize="14" Closing="Window_Closing">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="听见俄语 · 看见中文" FontSize="28" FontWeight="SemiBold" Foreground="#142B46"/><TextBlock Text="电脑声音实时翻译  /  Qwen3.8 LiveTranslate" Foreground="#65758B" Margin="0,7,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="声音来源（与播放器输出设备保持一致）" Margin="0,0,0,7"/><DockPanel><Button DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click" Margin="8,0,0,0"/><ComboBox x:Name="DeviceBox" Padding="8" VerticalContentAlignment="Center"/></DockPanel></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="API 密钥 · 仅本机加密保存" Margin="0,0,0,7"/><PasswordBox x:Name="KeyBox" Padding="10" BorderBrush="#D8E0EB"/></StackPanel>
    <Expander Grid.Row="1" Grid.ColumnSpan="3" Header="接口设置" Margin="0,13,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="实时接口地址（密钥必须与服务地域匹配）" Foreground="#65758B" Margin="0,0,0,6"/><TextBox x:Name="EndpointBox"/><TextBlock Text="源语言自动识别，目标语言为中文。开始后，所选设备的声音会发送给千问服务进行翻译。" TextWrapping="Wrap" Foreground="#65758B" Margin="0,8,0,0"/></StackPanel></Expander>
   </Grid>
  </Border>
  <DockPanel Grid.Row="2" Margin="0,0,0,16"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="StartButton" Content="开始翻译" Background="#237968" Foreground="White" Click="Start_Click"/><Button x:Name="StopButton" Content="停止" IsEnabled="False" Click="Stop_Click"/><Button Content="悬浮字幕" Click="Overlay_Click"/><Button Content="导出记录" Click="Export_Click"/><Button Content="清空" Click="Clear_Click"/></StackPanel><ProgressBar x:Name="LevelBar" Minimum="0" Maximum="1" Width="80" Height="7" HorizontalAlignment="Right" ToolTip="系统声音音量"/></DockPanel>
  <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="20">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="实时字幕" Foreground="#65758B" FontSize="13"/>
    <Border Grid.Row="1" Background="#EEF7F4" CornerRadius="8" Padding="18" Margin="0,12,0,18"><TextBlock x:Name="CurrentText" Text="准备好后，播放俄语音频并点击「开始翻译」。" FontSize="24" Foreground="#184D42" TextWrapping="Wrap" MaxHeight="150"/></Border>
    <ScrollViewer x:Name="HistoryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E9EEF4" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel><TextBlock Text="{Binding Time}" Foreground="#8B98AA" FontSize="11"/><TextBlock Text="{Binding Chinese}" FontSize="19" TextWrapping="Wrap" Foreground="#182F48" Margin="0,5,0,4"/><TextBlock Text="{Binding Russian}" TextWrapping="Wrap" Foreground="#697A90"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid>
  </Border>
  <TextBlock Grid.Row="4" x:Name="StatusText" Text="就绪 · 支持浏览器、视频播放器和会议的系统声音" Foreground="#65758B" Margin="0,14,0,0" TextWrapping="Wrap"/>
 </Grid>
</Window>
